VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Public URL of the deployed app. Used as the email-confirmation redirect so links work on other devices.
VITE_APP_URL=https://your-app.example.com
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_hugging_face_access_token_here
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VITE_LOGO_DEV_PUBLISHABLE_KEY=
# Optional: a private Solana RPC URL (e.g. https://mainnet.helius-rpc.com/?api-key=...) for crypto wallet scans.
# Public Solana nodes refuse Cloudflare for token lookups; in production set it with: npx wrangler secret put SOLANA_RPC_URL
SOLANA_RPC_URL=
